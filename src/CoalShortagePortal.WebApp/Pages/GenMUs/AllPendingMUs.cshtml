    <script>
        function downloadBothExcelFiles() {
            const exBusUrl = '@Url.Page("./AllPendingMUs", "ExportExBusExcel")';
            const genMuUrl = '@Url.Page("./AllPendingMUs", "ExportGenMuExcel")';

            downloadFileByIframe(exBusUrl);

            setTimeout(function () {
                downloadFileByIframe(genMuUrl);
            }, 800);
        }

        function downloadFileByIframe(url) {
            const iframe = document.createElement("iframe");
            iframe.style.display = "none";
            iframe.src = url;

            document.body.appendChild(iframe);

            setTimeout(function () {
                if (iframe && iframe.parentNode) {
                    iframe.parentNode.removeChild(iframe);
                }
            }, 10000);
        }
    </script>
