@page
@model CoalShortagePortal.WebApp.Pages.GenMUs.AllPendingMUsModel
@{
    ViewData["Title"] = "Pending MUs";
    var pendingCount = Model.PendingGenerators?.Count(p => !p.HasSubmitted) ?? 0;
    var submittedCount = Model.PendingGenerators?.Count(p => p.HasSubmitted) ?? 0;
    var allSubmitted = pendingCount == 0 && (Model.PendingGenerators?.Any() ?? false);
    var editingStations = Model.EditingStations ?? new List<string>();
    var editCount = Model.MUEntries?.Count(e => e.IsEditMode) ?? 0;
    var showSaveButton = pendingCount > 0 || editCount > 0;
}

<div class="container-fluid mt-4">
    <div class="row justify-content-md-center">
        <div class="col-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="fas fa-clock text-warning"></i> Pending MUs for Yesterday
                </h2>
                <div>
                    <span class="badge badge-lg badge-warning mr-2 blink-badge"
                          style="font-size:1rem; padding:0.5rem 1rem; color:#B5051C;">
                        <i class="fas fa-exclamation-circle"></i> Pending: @pendingCount
                    </span>
                    <span class="badge badge-lg badge-success"
                          style="font-size:1rem; padding:0.5rem 1rem; color:#069E3E;">
                        <i class="fas fa-check-circle"></i> Submitted: @submittedCount
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-md-center mb-3">
        <div class="col-10">
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i>
                <span class="ml-3">
                    <i class="fas fa-lightbulb"></i>
                    Enter <strong>MU &amp; ExBus, Peak MW, and Time</strong> values
                    for generators who haven't submitted yet for
                    <strong>@Model.YesterdayDate.ToString("dddd, MMMM dd, yyyy")</strong>.
                    Schedule MUs are only required for
                    <span class="badge badge-primary">ISGS</span> and
                    <span class="badge badge-primary">IPP</span> stations.
                </span>
            </div>
        </div>
    </div>

    @* Success Message *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle"></i>
                    <strong>Success!</strong>
                    @* ✅ Encode output — no Html.Raw for user-influenced messages *@
                    @TempData["SuccessMessage"]
                    <button type="button" class="close" data-dismiss="alert">
                        <span>&times;</span>
                    </button>
                </div>
            </div>
        </div>
    }

    @* Error Message *@
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle"></i>
                    <strong>Error!</strong>
                    @* ✅ Use Html.Raw only for server-generated messages with line breaks *@
                    @Html.Raw(System.Net.WebUtility.HtmlEncode(
                    TempData["ErrorMessage"]?.ToString() ?? "")
                                .Replace("&lt;br/&gt;", "<br/>"))
                <button type="button" class="close" data-dismiss="alert">
                    <span>&times;</span>
                </button>
            </div>
        </div>
    </div>
        }

    <div class="row justify-content-md-center">
        <div class="col-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-list"></i> All Generators Status
                    </h5>
                </div>
                <div class="card-body p-0">

                    @* ── Main data-entry form ── *@
                    <form method="post">
                        @* @Html.AntiForgeryToken() *@
                        <div class="">
                            <table class="table table-hover mb-0">
                                <thead class="thead-dark">
                                    <tr>
                                        <th style="width:3%;">#</th>
                                        <th style="width:13%;">
                                            <i class="fas fa-building"></i> STATION
                                        </th>
                                        <th style="width:13%;">
                                            <i class="fas fa-envelope"></i> EMAIL
                                        </th>
                                        <th style="width:8%;" class="text-center">
                                            <i class="fas fa-check"></i> STATUS
                                        </th>
                                        <th style="width:9%;" class="text-center">
                                            <i class="fas fa-bolt"></i> DAILY
                                        </th>
                                        <th style="width:9%;" class="text-center">
                                            <i class="fas fa-bolt"></i> SCHEDULE
                                            <br />
                                            <small style="font-size:0.62rem; opacity:0.85;">
                                                ISGS/IPP Only
                                            </small>
                                        </th>
                                        <th style="width:9%;" class="text-center">
                                            <i class="fas fa-plug"></i> ExBus
                                        </th>
                                        <th style="width:9%;" class="text-center">
                                            <i class="fas fa-arrow-up"></i> PEAK MW
                                        </th>
                                        <th style="width:9%;" class="text-center">
                                            <i class="fas fa-arrow-down"></i> OFF PEAK
                                        </th>
                                        <th style="width:9%;" class="text-center">
                                            <i class="fas fa-sun"></i> DAY PEAK
                                        </th>
                                        <th style="width:9%;" class="text-center">
                                            <i class="fas fa-chart-line"></i> MIN GEN
                                        </th>
                                        <th style="width:8%;" class="text-center">
                                            <i class="fas fa-cog"></i> ACTION
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.PendingGenerators != null
                                                                        && Model.PendingGenerators.Any())
                                    {
                                        var index = 0;
                                        var entryIndex = 0;

                                        @foreach (var generator in Model.PendingGenerators)
                                        {
                                            bool isEditing =
                                            editingStations.Contains(
                                            generator.StationName);
                                            var entry = Model.MUEntries?
                                            .ElementAtOrDefault(entryIndex);
                                            bool hasEntry =
                                            (!generator.HasSubmitted || isEditing)
                                            && entry != null;

                                            <tr class="@(generator.HasSubmitted
                                                                                                ? (isEditing ? "table-edit" : "table-success")
                                                                                                : "table-warning")">

                                                <td class="align-middle font-weight-bold">
                                                    @(++index)
                                                </td>

                                                <td class="align-middle">
                                                    <strong style="color:#2c3e50;">
                                                        <i class="fas fa-industry text-primary"></i>
                                                        @generator.StationName
                                                    </strong>
                                                    @if (!string.IsNullOrEmpty(generator.UserType))
                                                    {
                                                        <br />
                                                        <span class="badge @(generator.IsScheduleUser
                                                                                                                          ? "badge-usertype-schedule"
                                                                                                                          : "badge-usertype-other")"
                                                              style="font-size:0.65rem; border-radius:4px;">
                                                            @generator.UserType
                                                        </span>
                                                    }
                                                </td>

                                                <td class="align-middle">
                                                    <small style="color:#0E3747;">
                                                        @generator.Email
                                                    </small>
                                                </td>

                                                <td class="align-middle text-center">
                                                    @if (generator.HasSubmitted)
                                                    {
                                                        @if (isEditing)
                                                        {
                                                            <span class="badge badge-warning badge-pill px-3 py-2 text-dark">
                                                                <i class="fas fa-pencil-alt"></i>
                                                                <strong> Editing</strong>
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-success badge-pill px-3 py-2 text-dark">
                                                                <i class="fas fa-check-circle"></i>
                                                                <strong> Submitted</strong>
                                                            </span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-danger badge-pill px-3 py-2 text-dark">
                                                            <i class="fas fa-times-circle"></i>
                                                            <strong> Pending</strong>
                                                        </span>
                                                    }
                                                </td>

                                                @* ── DAILY MUs ── *@
                                                <td class="align-middle text-center">
                                                    @if (generator.HasSubmitted && !isEditing)
                                                    {
                                                        <span class="val-badge val-daily">
                                                            @generator.ExistingMUs?.ToString("N2")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <input type="hidden"
                                                               name="MUEntries[@(entryIndex)].StationName"
                                                               value="@generator.StationName" />
                                                        <input type="hidden"
                                                               name="MUEntries[@(entryIndex)].UserType"
                                                               value="@generator.UserType" />
                                                        <input type="hidden"
                                                               name="MUEntries[@(entryIndex)].IsEditMode"
                                                               value="@isEditing.ToString().ToLower()" />
                                                        <input type="number"
                                                               name="MUEntries[@(entryIndex)].DailyMUs"
                                                               class="form-control form-control-sm @(isEditing ? "input-edit" : "")"
                                                               step="0.01" min="0.01" max="99999.99"
                                                               value="@(isEditing? entry?.DailyMUs?.ToString() : "")"
                                                               placeholder="MUs"
                                                               style="max-width:130px; margin:0 auto;" />
                                                    }
                                                </td>

                                                @* ── SCHEDULE MUs ── *@
                                                <td class="align-middle text-center">
                                                    @if (generator.HasSubmitted && !isEditing)
                                                    {
                                                        @if (generator.IsScheduleUser)
                                                        {
                                                            <span class="val-badge val-schedule">
                                                                @generator.ExistingScheduleMUs?.ToString("N2")
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">
                                                                <i class="fas fa-minus"></i>
                                                            </span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        @if (generator.IsScheduleUser)
                                                        {
                                                            <input type="number"
                                                                   name="MUEntries[@(entryIndex)].ScheduleMUs"
                                                                   class="form-control form-control-sm @(isEditing ? "input-edit" : "")"
                                                                   step="0.01" min="0.01" max="99999.99"
                                                                   value="@(isEditing? entry?.ScheduleMUs?.ToString() : "")"
                                                                   placeholder="Sched MUs"
                                                                   style="max-width:130px; margin:0 auto;" />
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-secondary text-white px-2 py-1"
                                                                  style="font-size:0.75rem;"
                                                                  title="Not applicable for this station type">
                                                                N/A
                                                            </span>
                                                        }
                                                    }
                                                </td>

                                                @* ── ExBus ── *@
                                                <td class="align-middle text-center">
                                                    @if (generator.HasSubmitted && !isEditing)
                                                    {
                                                        <span class="val-badge val-exbus">
                                                            @generator.ExistingExBus?.ToString("N2")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <input type="number"
                                                               name="MUEntries[@(entryIndex)].ExBus"
                                                               class="form-control form-control-sm @(isEditing ? "input-edit" : "")"
                                                               step="0.01" min="0.01" max="99999.99"
                                                               value="@(isEditing? entry?.ExBus?.ToString() : "")"
                                                               placeholder="ExBus"
                                                               style="max-width:130px; margin:0 auto;" />
                                                    }
                                                </td>

                                                @* ── PEAK MW ── *@
                                                <td class="align-middle text-center">
                                                    @if (generator.HasSubmitted && !isEditing)
                                                    {
                                                        <div>
                                                            <span class="val-badge val-peak">
                                                                @generator.ExistingPeakMW MW
                                                            </span>
                                                            <small class="time-label">
                                                                @generator.ExistingPeakMWTime?.ToString(@"hh\:mm")
                                                            </small>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <input type="number"
                                                               name="MUEntries[@(entryIndex)].PeakMW"
                                                               class="form-control form-control-sm mb-1 @(isEditing ? "input-edit" : "")"
                                                               step="1" min="1" max="99999"
                                                               value="@(isEditing? entry?.PeakMW?.ToString() : "")"
                                                               placeholder="MW"
                                                               style="max-width:110px; margin:0 auto;" />
                                                        <input type="time"
                                                               name="MUEntries[@(entryIndex)].PeakMWTime"
                                                               class="form-control form-control-sm @(isEditing ? "input-edit" : "")"
                                                               value="@(entry?.PeakMWTime?.ToString(@"hh\:mm") ?? "19:00")"
                                                               style="max-width:110px; margin:0 auto;" />
                                                    }
                                                </td>

                                                @* ── OFF PEAK MW ── *@
                                                <td class="align-middle text-center">
                                                    @if (generator.HasSubmitted && !isEditing)
                                                    {
                                                        <div>
                                                            <span class="val-badge val-offpeak">
                                                                @generator.ExistingOffPeakMW MW
                                                            </span>
                                                            <small class="time-label">
                                                                @generator.ExistingOffPeakMWTime?.ToString(@"hh\:mm")
                                                            </small>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <input type="number"
                                                               name="MUEntries[@(entryIndex)].OffPeakMW"
                                                               class="form-control form-control-sm mb-1 @(isEditing ? "input-edit" : "")"
                                                               step="1" min="1" max="99999"
                                                               value="@(isEditing? entry?.OffPeakMW?.ToString() : "")"
                                                               placeholder="MW"
                                                               style="max-width:110px; margin:0 auto;" />
                                                        <input type="time"
                                                               name="MUEntries[@(entryIndex)].OffPeakMWTime"
                                                               class="form-control form-control-sm @(isEditing ? "input-edit" : "")"
                                                               value="@(entry?.OffPeakMWTime?.ToString(@"hh\:mm") ?? "03:00")"
                                                               style="max-width:110px; margin:0 auto;" />
                                                    }
                                                </td>

                                                @* ── DAY PEAK MW ── *@
                                                <td class="align-middle text-center">
                                                    @if (generator.HasSubmitted && !isEditing)
                                                    {
                                                        <div>
                                                            <span class="val-badge val-daypeak">
                                                                @generator.ExistingDayPeakMW MW
                                                            </span>
                                                            <small class="time-label">
                                                                @generator.ExistingDayPeakMWTime?.ToString(@"hh\:mm")
                                                            </small>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <input type="number"
                                                               name="MUEntries[@(entryIndex)].DayPeakMW"
                                                               class="form-control form-control-sm mb-1 @(isEditing ? "input-edit" : "")"
                                                               step="1" min="1" max="99999"
                                                               value="@(isEditing? entry?.DayPeakMW?.ToString() : "")"
                                                               placeholder="MW"
                                                               style="max-width:110px; margin:0 auto;" />
                                                        <input type="time"
                                                               name="MUEntries[@(entryIndex)].DayPeakMWTime"
                                                               class="form-control form-control-sm @(isEditing ? "input-edit" : "")"
                                                               value="@(entry?.DayPeakMWTime?.ToString(@"hh\:mm") ?? "")"
                                                               style="max-width:110px; margin:0 auto;" />
                                                    }
                                                </td>

                                                @* ── MIN GENERATION ── *@
                                                <td class="align-middle text-center">
                                                    @if (generator.HasSubmitted && !isEditing)
                                                    {
                                                        <div>
                                                            <span class="val-badge val-mingen">
                                                                @generator.ExistingMinGeneration MW
                                                            </span>
                                                            <small class="time-label">
                                                                @generator.ExistingMinGenerationTime?.ToString(@"hh\:mm")
                                                            </small>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <input type="number"
                                                               name="MUEntries[@(entryIndex)].MinGeneration"
                                                               class="form-control form-control-sm mb-1 @(isEditing ? "input-edit" : "")"
                                                               step="1" min="1" max="99999"
                                                               value="@(isEditing? entry?.MinGeneration?.ToString() : "")"
                                                               placeholder="MW"
                                                               style="max-width:110px; margin:0 auto;" />
                                                        <input type="time"
                                                               name="MUEntries[@(entryIndex)].MinGenerationTime"
                                                               class="form-control form-control-sm @(isEditing ? "input-edit" : "")"
                                                               value="@(entry?.MinGenerationTime?.ToString(@"hh\:mm") ?? "")"
                                                               style="max-width:110px; margin:0 auto;" />
                                                    }
                                                    @if (!generator.HasSubmitted || isEditing)
                                                    {
                                                        entryIndex++;
                                                    }
                                                </td>

                                                @* ── ACTION ── *@
                                                <td class="align-middle text-center">
                                                    @if (generator.HasSubmitted && User.Identity.Name?.ToLower() == "admin")
                                                    {
                                                        <div class="d-flex justify-content-center gap-1">
                                                            @if (!isEditing)
                                                            {
                                                                @* ✅ Edit — GET request, no CSRF needed *@
                                                                <a asp-page-handler="ToggleEdit"
                                                                   asp-route-stationName="@generator.StationName"
                                                                   class="btn btn-sm btn-warning"
                                                                   title="Edit this record">
                                                                    <i class="fas fa-pencil-alt"></i>
                                                                </a>
                                                            }
                                                            @* ✅ Delete — separate form with AntiForgeryToken *@
                                                            <button type="submit"
                                                                    asp-page-handler="Delete"
                                                                    name="stationName"
                                                                    value="@generator.StationName"
                                                                    class="btn btn-sm btn-danger"
                                                                    title="Delete"
                                                                    onclick="return confirm('Delete record for @generator.StationName?');">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="12" class="text-center py-5">
                                                <div style="color:#6c757d;">
                                                    <i class="fas fa-inbox fa-3x mb-3 d-block"
                                                       style="opacity:0.5;"></i>
                                                    <h5>No generators found</h5>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (showSaveButton)
                        {
                            <div class="card-footer bg-light">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="fas fa-info-circle text-primary"></i>
                                        <small class="text-muted">
                                            @if (pendingCount > 0 && editCount > 0)
                                            {
                                                <text>
                                                    Saving @pendingCount pending +
                                                    @editCount edited record(s).
                                                    Schedule MUs only for ISGS/IPP.
                                                </text>
                                            }
                                            else if (editCount > 0)
                                            {
                                                <text>Saving @editCount edited record(s).</text>
                                            }
                                            else
                                            {
                                                <text>
                                                    Enter values for pending generators
                                                    and click Save All.
                                                </text>
                                            }
                                        </small>
                                    </div>
                                    <button type="submit" class="btn btn-success btn-lg">
                                        <i class="fas fa-save"></i> SAVE ALL MU DATA
                                    </button>
                                </div>
                            </div>
                        }
                    </form>

                </div>
            </div>

            <!-- Export Button for ExBus & GenMu -->
            <div class="d-flex flex-column align-items-end mt-3 mb-5">
                <button type="button"
                        class="btn btn-export-active btn-lg"
                        onclick="downloadBothExcelFiles()">
                    <i class="fas fa-file-excel mr-2"></i>
                    Export Yesterday's Data to Excel
                </button>

                <small class="text-success mt-2">
                    <i class="fas fa-check-circle mr-1"></i>
                    This will download ExBus and GenMU files separately.
                </small>
            </div>

            <!-- Export Button -->
            @*<div class="d-flex flex-column align-items-end mt-3 mb-5">
                <a asp-page-handler="ExportExcel"
                   class="btn btn-export-active btn-lg">
                    <i class="fas fa-file-excel mr-2"></i>
                    Export Yesterday's Data to Excel
                </a>
                 @if (allSubmitted)
                {
                    <a asp-page-handler="ExportExcel"
                       class="btn btn-export-active btn-lg">
                        <i class="fas fa-file-excel mr-2"></i>
                        Export Yesterday's Data to Excel
                    </a>
                    <small class="text-success mt-2">
                        <i class="fas fa-check-circle mr-1"></i>
                        All @submittedCount station(s) submitted — export is ready!
                    </small>
                }
                else
                {
                    <button class="btn btn-export-locked btn-lg" disabled
                            title="All generators must submit before export">
                        <i class="fas fa-lock mr-2"></i>
                        Export Yesterday's Data to Excel
                    </button>
                    <small class="text-danger mt-2">
                        <i class="fas fa-hourglass-half mr-1"></i>
                        @pendingCount station(s) still pending —
                        export unlocks when all submit
                    </small>
                } 
            </div>*@
        </div>
    </div>
</div>

<style>
    body {
        background-color: #FCF7F7;
    }

    .card {
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0,0,0,0.10) !important;
        transition: box-shadow 0.3s;
    }

    .card-header {
        border-bottom: 3px solid rgba(0,0,0,0.1);
        padding: 1rem 1.5rem;
    }

    .table {
        font-size: 0.9rem;
        background-color: #ffffff;
        margin-bottom: 0;
    }

        .table thead th {
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.72rem;
            letter-spacing: 1px;
            padding: 0.85rem 0.75rem;
            border: none;
            color: #ffffff !important;
        }

    .thead-dark tr th:nth-child(1) {
        background-color: #2c3e50 !important;
    }

    .thead-dark tr th:nth-child(2) {
        background-color: #2c3e50 !important;
    }

    .thead-dark tr th:nth-child(3) {
        background-color: #2c3e50 !important;
    }

    .thead-dark tr th:nth-child(4) {
        background-color: #2c3e50 !important;
    }

    .thead-dark tr th:nth-child(5) {
        background-color: #1565c0 !important;
    }

    .thead-dark tr th:nth-child(6) {
        background-color: #6a1b9a !important;
    }

    .thead-dark tr th:nth-child(7) {
        background-color: #2e7d32 !important;
    }

    .thead-dark tr th:nth-child(8) {
        background-color: #b71c1c !important;
    }

    .thead-dark tr th:nth-child(9) {
        background-color: #e65100 !important;
    }

    .thead-dark tr th:nth-child(10) {
        background-color: #f9a825 !important;
        color: #212529 !important;
    }

    .thead-dark tr th:nth-child(11) {
        background-color: #00695c !important;
    }

    .thead-dark tr th:nth-child(12) {
        background-color: #37474f !important;
    }

    .table tbody td {
        padding: 0.85rem 0.75rem;
        vertical-align: middle;
        border-bottom: 1px solid #e9ecef;
    }

    .table-warning {
        background-color: #fff8e1 !important;
    }

    .table-success {
        background-color: #e8f5e9 !important;
    }

    .table-edit {
        background-color: #fff3e0 !important;
        border-left: 4px solid #ff9800 !important;
    }

    .table tbody tr {
        transition: all 0.18s ease;
        border-left: 4px solid transparent;
    }

    .table-success:hover {
        background-color: #c8e6c9 !important;
        border-left-color: #388e3c !important;
        transform: translateX(3px);
        box-shadow: 0 3px 10px rgba(56,142,60,0.15);
    }

