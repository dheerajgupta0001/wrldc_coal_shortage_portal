@model IReadOnlyList<CoalShortagePortal.WebApp.Models.UnitAuxiliaryConsumptionListItemVM>
@{
    ViewData["Title"] = "Unit Auxiliary Consumption";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>
        <a asp-action="Create" class="btn btn-primary">Add Unit Data</a>
    </div>

    <p class="text-muted">Each row represents a change. The latest row for each station and unit is used for calculations.</p>

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Station Name</th>
                    <th>Unit No</th>
                    <th>Capacity (MW)</th>
                    <th>Auxiliary Consumption (%)</th>
                    <th>Normative DC (MW)</th>
                    <th>Updated On</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center">No unit data has been added.</td></tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.StationName</td>
                            <td>@item.UnitNumber</td>
                            <td>@item.InstalledCapacityMw.ToString("0.###")</td>
                            <td>@item.AuxiliaryConsumptionPercent.ToString("0.##")%</td>
                            <td>@item.NormativeCapacityMw.ToString("0.###")</td>
                            <td>@item.UpdatedOn.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
